class SettingsDialog(Gtk.Dialog):
    def __init__(self, parent, config, on_config_changed_cb):
        self.config = config
        lang = self.config.get("language", "en")
        self.t = TRANSLATIONS.get(lang, TRANSLATIONS["en"])
        
        super().__init__(title=self.t["preferences"], transient_for=parent, flags=0)
        self.set_default_size(380, 500)
        self.set_border_width(14)
        self.on_config_changed = on_config_changed_cb

        box = self.get_content_area()
        box.set_spacing(14)

        # 1. Language Section
        card_lang = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        card_lang.get_style_context().add_class("card-box")

        lbl_lg = Gtk.Label(xalign=0)
        lbl_lg.set_markup(f"<b>🌐 {self.t['lang_title']}</b>")
        card_lang.pack_start(lbl_lg, False, False, 0)

        grid_lg = Gtk.Grid()
        grid_lg.set_column_homogeneous(True)
        grid_lg.set_column_spacing(6)

        cur_lang = self.config.get("language", "en")
        self.btn_lang_en = Gtk.RadioButton.new_with_label_from_widget(None, self.t["lang_en"])
        self.btn_lang_en.set_mode(False)
        self.btn_lang_en.get_style_context().add_class("preset-btn")
        self.btn_lang_en.connect("toggled", lambda b: self.set_lang("en") if b.get_active() else None)
        grid_lg.attach(self.btn_lang_en, 0, 0, 1, 1)

        self.btn_lang_fr = Gtk.RadioButton.new_with_label_from_widget(self.btn_lang_en, self.t["lang_fr"])
        self.btn_lang_fr.set_mode(False)
        self.btn_lang_fr.get_style_context().add_class("preset-btn")
        self.btn_lang_fr.connect("toggled", lambda b: self.set_lang("fr") if b.get_active() else None)
        grid_lg.attach(self.btn_lang_fr, 1, 0, 1, 1)

        if cur_lang == "fr":
            self.btn_lang_fr.set_active(True)
        else:
            self.btn_lang_en.set_active(True)

        card_lang.pack_start(grid_lg, False, False, 0)
        box.pack_start(card_lang, False, False, 0)

        # 2. Theme Section
        card_theme = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        card_theme.get_style_context().add_class("card-box")
        
        lbl_th = Gtk.Label(xalign=0)
        lbl_th.set_markup(f"<b>🌓 {self.t['theme_title']}</b>")
        card_theme.pack_start(lbl_th, False, False, 0)

        grid_th = Gtk.Grid()
        grid_th.set_column_homogeneous(True)
        grid_th.set_column_spacing(6)

        cur_th = self.config.get("theme_mode", "system")

        self.btn_th_sys = Gtk.RadioButton.new_with_label_from_widget(None, self.t["theme_auto"])
        self.btn_th_sys.set_mode(False)
        self.btn_th_sys.get_style_context().add_class("preset-btn")
        self.btn_th_sys.connect("toggled", lambda b: self.set_theme("system") if b.get_active() else None)
        grid_th.attach(self.btn_th_sys, 0, 0, 1, 1)

        self.btn_th_dark = Gtk.RadioButton.new_with_label_from_widget(self.btn_th_sys, self.t["theme_dark"])
        self.btn_th_dark.set_mode(False)
        self.btn_th_dark.get_style_context().add_class("preset-btn")
        self.btn_th_dark.connect("toggled", lambda b: self.set_theme("dark") if b.get_active() else None)
        grid_th.attach(self.btn_th_dark, 1, 0, 1, 1)

        self.btn_th_light = Gtk.RadioButton.new_with_label_from_widget(self.btn_th_sys, self.t["theme_light"])
        self.btn_th_light.set_mode(False)
        self.btn_th_light.get_style_context().add_class("preset-btn")
        self.btn_th_light.connect("toggled", lambda b: self.set_theme("light") if b.get_active() else None)
        grid_th.attach(self.btn_th_light, 2, 0, 1, 1)

        if cur_th == "dark":
            self.btn_th_dark.set_active(True)
        elif cur_th == "light":
            self.btn_th_light.set_active(True)
        else:
            self.btn_th_sys.set_active(True)

        card_theme.pack_start(grid_th, False, False, 0)
        box.pack_start(card_theme, False, False, 0)

        # 3. Notifications & Alerts
        card_notif = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        card_notif.get_style_context().add_class("card-box")

        lbl_nt = Gtk.Label(xalign=0)
        lbl_nt.set_markup(f"<b>🔔 {self.t['notif_title']}</b>")
        card_notif.pack_start(lbl_nt, False, False, 0)

        row_n1 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        lbl_n1 = Gtk.Label(label=self.t["notif_unlock"], xalign=0)
        sw_n1 = Gtk.Switch()
        sw_n1.set_active(self.config.get("notify_on_grace", True))
        sw_n1.connect("state-set", lambda sw, st: self.set_opt("notify_on_grace", st))
        row_n1.pack_start(lbl_n1, True, True, 0)
        row_n1.pack_start(sw_n1, False, False, 0)
        card_notif.pack_start(row_n1, False, False, 0)

        row_n2 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        lbl_n2 = Gtk.Label(label=self.t["notif_battery"], xalign=0)
        sw_n2 = Gtk.Switch()
        sw_n2.set_active(self.config.get("battery_warning", True))
        sw_n2.connect("state-set", lambda sw, st: self.set_opt("battery_warning", st))
        row_n2.pack_start(lbl_n2, True, True, 0)
        row_n2.pack_start(sw_n2, False, False, 0)
        card_notif.pack_start(row_n2, False, False, 0)

        box.pack_start(card_notif, False, False, 0)

        # 4. Grace Period (Anti-Lockout)
        card_grace = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        card_grace.get_style_context().add_class("card-box")

        lbl_gr = Gtk.Label(xalign=0)
        lbl_gr.set_markup(f"<b>⏱️ {self.t['grace_title']}</b>")
        card_grace.pack_start(lbl_gr, False, False, 0)

        row_gr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        lbl_gr_desc = Gtk.Label(label=self.t["grace_desc"], xalign=0)
        self.lbl_gr_val = Gtk.Label(label=f"{int(self.config.get('unlock_grace_period', 60))}s", xalign=1)
        self.lbl_gr_val.get_style_context().add_class("pill-badge")
        row_gr.pack_start(lbl_gr_desc, True, True, 0)
        row_gr.pack_start(self.lbl_gr_val, False, False, 0)
        card_grace.pack_start(row_gr, False, False, 0)

        scale_gr = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 30, 300, 15)
        scale_gr.set_draw_value(False)
        scale_gr.set_value(self.config.get("unlock_grace_period", 60))
        scale_gr.connect("value-changed", self.on_grace_scale_changed)
        card_grace.pack_start(scale_gr, False, False, 0)

        box.pack_start(card_grace, False, False, 0)

        self.show_all()

    def set_lang(self, lang):
        self.config["language"] = lang
        self.on_config_changed(rebuild_ui=True)

    def set_theme(self, mode):
        self.config["theme_mode"] = mode
        self.on_config_changed(rebuild_ui=False)

    def set_opt(self, key, val):
        self.config[key] = val
        self.on_config_changed(rebuild_ui=False)

    def on_grace_scale_changed(self, scale):
        val = int(scale.get_value())
        self.lbl_gr_val.set_text(f"{val}s")
        self.config["unlock_grace_period"] = val
        self.on_config_changed(rebuild_ui=False)


class DynamicLockApp(Gtk.Window):
    def __init__(self):
        super().__init__()
        self.set_default_size(440, 590)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_border_width(18)

        self.updating_ui_from_preset = False

        # Load config first
        self.config = self.load_config()
        self.devices_list = []
        self.t = self.get_strings()

        self.set_title(self.t["app_title"])

        self.init_css()
        self.init_theme_sync()

        self.setup_ui()
        self.load_devices()
        self.apply_config_to_ui()

        # Live signal loop (every 500ms)
        GLib.timeout_add(500, self.update_live_signal)

    def get_strings(self):
        lang = self.config.get("language", "en")
        return TRANSLATIONS.get(lang, TRANSLATIONS["en"])

    def init_css(self):
        css_provider = Gtk.CssProvider()
        css_provider.load_from_data(STYLE_CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            css_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def init_theme_sync(self):
        try:
            self.desktop_settings = Gio.Settings.new('org.gnome.desktop.interface')
            self.desktop_settings.connect('changed::color-scheme', self.on_system_theme_changed)
            self.desktop_settings.connect('changed::gtk-theme', self.on_system_theme_changed)
            self.sync_gtk_theme()
        except Exception:
            pass

    def on_system_theme_changed(self, settings, key):
        self.sync_gtk_theme()

    def sync_gtk_theme(self):
        mode = self.config.get("theme_mode", "system")
        gtk_settings = Gtk.Settings.get_default()
        if not gtk_settings:
            return

        if mode == "dark":
            gtk_settings.set_property('gtk-application-prefer-dark-theme', True)
        elif mode == "light":
            gtk_settings.set_property('gtk-application-prefer-dark-theme', False)
        else:
            try:
                scheme = self.desktop_settings.get_string('color-scheme')
                gtk_theme = self.desktop_settings.get_string('gtk-theme')
                is_dark = (scheme == 'prefer-dark' or 'dark' in gtk_theme.lower())
                gtk_settings.set_property('gtk-application-prefer-dark-theme', is_dark)
            except Exception:
                pass

    def load_config(self):
        try:
            if os.path.exists(CONFIG_PATH):
                with open(CONFIG_PATH, 'r') as f:
                    return {**DEFAULT_CONFIG, **json.load(f)}
        except Exception:
            pass
        return DEFAULT_CONFIG.copy()

    def save_config(self):
        os.makedirs(CONFIG_DIR, exist_ok=True)
        try:
            with open(CONFIG_PATH, 'w') as f:
                json.dump(self.config, f, indent=2)
        except Exception as e:
            print("Error saving config:", e)

    def setup_ui(self):
        # Remove previous children if rebuilding
        for child in self.get_children():
            self.remove(child)

        self.t = self.get_strings()
        self.set_title(self.t["app_title"])

        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        self.add(main_box)

        # HeaderBar
        header = Gtk.HeaderBar()
        header.set_title(self.t["app_title"])
        header.set_show_close_button(True)
        self.set_titlebar(header)

        # Settings Gear Button
        btn_settings = Gtk.Button.new_from_icon_name("emblem-system-symbolic", Gtk.IconSize.BUTTON)
        btn_settings.set_tooltip_text(self.t["settings_tooltip"])
        btn_settings.connect("clicked", self.open_settings_dialog)
        header.pack_start(btn_settings)

        # Main Switch in HeaderBar
        self.switch_enabled = Gtk.Switch()
        self.switch_enabled.set_valign(Gtk.Align.CENTER)
        self.switch_enabled.connect("state-set", self.on_switch_toggled)
        header.pack_end(self.switch_enabled)

        # --- Card 1 : Hero Status & Telemetry ---
        card_hero = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        card_hero.get_style_context().add_class("card-box")

        # Top row: Device Selector & Battery Pill
        row_dev = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.combo_devices = Gtk.ComboBoxText()
        self.combo_devices.set_hexpand(True)
        self.combo_devices.connect("changed", self.on_device_changed)
        row_dev.pack_start(self.combo_devices, True, True, 0)

        self.lbl_battery = Gtk.Label(label="🔋 69%")
        self.lbl_battery.get_style_context().add_class("pill-badge")
        row_dev.pack_start(self.lbl_battery, False, False, 0)
        card_hero.pack_start(row_dev, False, False, 0)

        # Progress bar (Thin & Sleek)
        self.progress_signal = Gtk.ProgressBar()
        self.progress_signal.get_style_context().add_class("signal-progress")
        self.progress_signal.set_fraction(1.0)
        card_hero.pack_start(self.progress_signal, False, False, 0)

        # Status text row
        row_status = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.lbl_status = Gtk.Label(xalign=0)
        self.lbl_status.set_markup(f"<span color='#2ecc71'>● <b>{self.t['status_close']}</b></span>")
        row_status.pack_start(self.lbl_status, True, True, 0)

        self.lbl_signal_val = Gtk.Label(label="100% • 0 dBm", xalign=1)
        self.lbl_signal_val.get_style_context().add_class("dim-label")
        row_status.pack_start(self.lbl_signal_val, False, False, 0)
        card_hero.pack_start(row_status, False, False, 0)

        main_box.pack_start(card_hero, False, False, 0)

        # --- Card 2 : Presets (Zones de Distance) ---
        box_presets_wrapper = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        
        lbl_presets_title = Gtk.Label(xalign=0)
        lbl_presets_title.set_markup(f"<b>{self.t['detection_zone']}</b>")
        box_presets_wrapper.pack_start(lbl_presets_title, False, False, 0)

        grid_presets = Gtk.Grid()
        grid_presets.set_column_homogeneous(True)
        grid_presets.set_column_spacing(8)

        self.btn_strict = Gtk.RadioButton.new_with_label_from_widget(None, self.t["preset_strict_title"])
        self.btn_strict.get_child().set_use_markup(True)
        self.btn_strict.set_mode(False)
        self.btn_strict.get_style_context().add_class("preset-btn")
        self.btn_strict.connect("toggled", lambda b: self.on_preset_btn_toggled("strict") if b.get_active() else None)
        grid_presets.attach(self.btn_strict, 0, 0, 1, 1)

        self.btn_comfort = Gtk.RadioButton.new_with_label_from_widget(self.btn_strict, self.t["preset_comfort_title"])
        self.btn_comfort.get_child().set_use_markup(True)
        self.btn_comfort.set_mode(False)
        self.btn_comfort.get_style_context().add_class("preset-btn")
        self.btn_comfort.connect("toggled", lambda b: self.on_preset_btn_toggled("comfort") if b.get_active() else None)
        grid_presets.attach(self.btn_comfort, 1, 0, 1, 1)

        self.btn_exit = Gtk.RadioButton.new_with_label_from_widget(self.btn_strict, self.t["preset_exit_title"])
        self.btn_exit.get_child().set_use_markup(True)
        self.btn_exit.set_mode(False)
        self.btn_exit.get_style_context().add_class("preset-btn")
        self.btn_exit.connect("toggled", lambda b: self.on_preset_btn_toggled("exit") if b.get_active() else None)
        grid_presets.attach(self.btn_exit, 2, 0, 1, 1)

        box_presets_wrapper.pack_start(grid_presets, False, False, 0)

        self.lbl_preset_desc = Gtk.Label(xalign=0)
        self.lbl_preset_desc.set_markup(f"<small class='dim-label'>{self.t['preset_strict_desc']}</small>")
        box_presets_wrapper.pack_start(self.lbl_preset_desc, False, False, 0)

        main_box.pack_start(box_presets_wrapper, False, False, 0)

        # --- Expander : Manual Sliders ---
        expander = Gtk.Expander(label=self.t["manual_adjustments"])
        box_sliders = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box_sliders.set_margin_top(8)
        box_sliders.set_margin_bottom(8)
        box_sliders.get_style_context().add_class("card-box")

        # Slider Seuil
        row_lq = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        lbl_lq = Gtk.Label(label=self.t["req_sensitivity"], xalign=0)
        self.lbl_lq_val = Gtk.Label(label="95%", xalign=1)
        self.lbl_lq_val.get_style_context().add_class("pill-badge")
        row_lq.pack_start(lbl_lq, True, True, 0)
        row_lq.pack_start(self.lbl_lq_val, False, False, 0)
        box_sliders.pack_start(row_lq, False, False, 0)

        self.scale_lq = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 50, 98, 1)
        self.scale_lq.set_draw_value(False)
        self.scale_lq.connect("value-changed", self.on_lq_scale_changed)
        box_sliders.pack_start(self.scale_lq, False, False, 0)

        # Slider Délai
        row_delay = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        lbl_delay = Gtk.Label(label=self.t["lock_delay"], xalign=0)
        self.lbl_delay_val = Gtk.Label(label="1.0s", xalign=1)
        self.lbl_delay_val.get_style_context().add_class("pill-badge")
        row_delay.pack_start(lbl_delay, True, True, 0)
        row_delay.pack_start(self.lbl_delay_val, False, False, 0)
        box_sliders.pack_start(row_delay, False, False, 0)

        self.scale_delay = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0.5, 8.0, 0.5)
        self.scale_delay.set_draw_value(False)
        self.scale_delay.connect("value-changed", self.on_delay_scale_changed)
        box_sliders.pack_start(self.scale_delay, False, False, 0)

        expander.add(box_sliders)
        main_box.pack_start(expander, False, False, 0)

        # Spacer
        spacer = Gtk.Box()
        main_box.pack_start(spacer, True, True, 0)

        # --- Footer Actions ---
        btn_test = Gtk.Button.new_with_label(self.t["test_lock"])
        btn_test.get_style_context().add_class("action-btn")
        btn_test.connect("clicked", lambda b: subprocess.run(['loginctl', 'lock-session']))
        main_box.pack_start(btn_test, False, False, 0)

        self.show_all()

    def open_settings_dialog(self, btn):
        dlg = SettingsDialog(self, self.config, self.on_settings_updated)
        dlg.run()
        dlg.destroy()

    def on_settings_updated(self, rebuild_ui=False):
        self.save_config()
        self.sync_gtk_theme()
        if rebuild_ui:
            self.setup_ui()
            self.load_devices()
            self.apply_config_to_ui()

    def load_devices(self):
        self.combo_devices.remove_all()
        self.devices_list = []
        try:
            out = subprocess.check_output(['bluetoothctl', 'devices'], stderr=subprocess.DEVNULL).decode().strip()
            for line in out.splitlines():
                parts = line.split()
                if len(parts) >= 3 and parts[0] == 'Device':
                    mac = parts[1]
                    name = " ".join(parts[2:])
                    self.devices_list.append((mac, name))
                    self.combo_devices.append(mac, f"{name}")
        except Exception:
            pass

        mac = self.config.get("device_mac")
        if mac:
            self.combo_devices.set_active_id(mac)
        elif self.devices_list:
            self.combo_devices.set_active(0)

    def apply_config_to_ui(self):
        self.updating_ui_from_preset = True
        self.switch_enabled.set_active(self.config.get("enabled", True))
        
        preset_key = self.config.get("preset", "strict")
        if preset_key == "strict":
            self.btn_strict.set_active(True)
        elif preset_key == "comfort":
            self.btn_comfort.set_active(True)
        elif preset_key == "exit":
            self.btn_exit.set_active(True)

        if preset_key in PRESETS:
            desc_key = f"preset_{preset_key}_desc"
            self.lbl_preset_desc.set_markup(f"<small class='dim-label'>{self.t.get(desc_key, '')}</small>")

        lq = self.config.get("lq_threshold", 95)
        self.scale_lq.set_value(lq)
        self.lbl_lq_val.set_text(f"{int(lq)}%")

        delay = self.config.get("delay_seconds", 1.0)
        self.scale_delay.set_value(delay)
        self.lbl_delay_val.set_text(f"{delay:.1f}s")
        self.updating_ui_from_preset = False

    def on_switch_toggled(self, switch, state):
        self.config["enabled"] = state
        self.save_config()

    def on_device_changed(self, combo):
        active_id = combo.get_active_id()
        if active_id:
            self.config["device_mac"] = active_id
            for mac, name in self.devices_list:
                if mac == active_id:
                    self.config["device_name"] = name
                    break
            self.save_config()

    def on_preset_btn_toggled(self, preset_key):
        if preset_key not in PRESETS:
            return

        desc_key = f"preset_{preset_key}_desc"
        self.lbl_preset_desc.set_markup(f"<small class='dim-label'>{self.t.get(desc_key, '')}</small>")
        self.config["preset"] = preset_key
        
        pinfo = PRESETS[preset_key]
        self.updating_ui_from_preset = True
        self.config["lq_threshold"] = pinfo["lq"]
        self.config["rssi_threshold"] = pinfo["rssi"]
        self.config["delay_seconds"] = pinfo["delay"]

        self.scale_lq.set_value(pinfo["lq"])
        self.lbl_lq_val.set_text(f"{pinfo['lq']}%")

        self.scale_delay.set_value(pinfo["delay"])
        self.lbl_delay_val.set_text(f"{pinfo['delay']:.1f}s")
        self.updating_ui_from_preset = False

        self.save_config()

    def on_lq_scale_changed(self, scale):
        val = int(scale.get_value())
        self.lbl_lq_val.set_text(f"{val}%")
        self.config["lq_threshold"] = val
        if not self.updating_ui_from_preset:
            self.config["preset"] = "custom"
        self.save_config()

    def on_delay_scale_changed(self, scale):
        val = round(scale.get_value(), 1)
        self.lbl_delay_val.set_text(f"{val:.1f}s")
        self.config["delay_seconds"] = val
        if not self.updating_ui_from_preset:
            self.config["preset"] = "custom"
        self.save_config()

    def update_live_signal(self):
        mac = self.config.get("device_mac")
        if not mac:
            self.progress_signal.set_fraction(0.0)
            self.lbl_status.set_markup(f"<span color='#e74c3c'>● {self.t['status_none']}</span>")
            self.lbl_signal_val.set_text("N/A")
            return True

        lq = None
        rssi = None
        connected = False

        try:
            out = subprocess.check_output(['bluetoothctl', 'info', mac], stderr=subprocess.DEVNULL).decode()
            connected = ('Connected: yes' in out)
        except Exception:
            connected = False

        if connected:
            try:
                out = subprocess.check_output(['hcitool', 'lq', mac], stderr=subprocess.DEVNULL).decode().strip()
                if 'Link quality:' in out:
                    lq = int(out.split(':')[1].strip())
            except Exception:
                lq = None

            try:
                out = subprocess.check_output(['hcitool', 'rssi', mac], stderr=subprocess.DEVNULL).decode().strip()
                if 'RSSI return value:' in out:
                    rssi = int(out.split(':')[1].strip())
            except Exception:
                rssi = None

        # Battery update
        try:
            out = subprocess.check_output(['adb', 'shell', 'dumpsys', 'battery'], stderr=subprocess.DEVNULL).decode()
            for line in out.splitlines():
                if 'level:' in line:
                    bval = line.split(':')[1].strip()
                    self.lbl_battery.set_text(f"🔋 {bval}%")
                    break
        except Exception:
            pass

        thresh = self.config.get("lq_threshold", 95)

        if not connected:
            self.progress_signal.set_fraction(0.0)
            self.lbl_status.set_markup(f"<span color='#95a5a6'>● <b>{self.t['status_standby']}</b></span>")
            self.lbl_signal_val.set_text("Standby")
        elif lq is not None:
            frac = max(0.0, min(1.0, lq / 100.0))
            self.progress_signal.set_fraction(frac)
            rssi_str = f"{rssi} dBm" if rssi is not None else "0 dBm"
            self.lbl_signal_val.set_text(f"{lq}% • {rssi_str}")
            
            if lq >= thresh:
                self.lbl_status.set_markup(f"<span color='#2ecc71'>● <b>{self.t['status_close']}</b></span>")
            else:
                self.lbl_status.set_markup(f"<span color='#f39c12'>● <b>{self.t['status_away']}</b></span>")
        else:
            self.progress_signal.set_fraction(0.5)
            self.lbl_status.set_markup(f"<span color='#3498db'>● {self.t['status_searching']}</span>")
            self.lbl_signal_val.set_text("--")

        return True

def main():
    app = DynamicLockApp()
    app.connect("destroy", Gtk.main_quit)
    app.show_all()
    Gtk.main()

if __name__ == '__main__':
    main()
