#!/usr/bin/env python3
"""
Dynamic Lock - Minimalist & Sleek GUI Manager for Linux (Pop!_OS / GNOME).
Clean Libadwaita-inspired interface with real-time Bluetooth telemetry,
instant profile switching, and dynamic Dark/Light theme adaptation.
"""

import sys
import os
import json
import subprocess
import gi
gi.require_version('Gtk', '3.0')
gi.require_version('Gio', '2.0')
from gi.repository import Gtk, GLib, Gio, Gdk

CONFIG_DIR = os.path.expanduser('~/.config/dynamic-lock')
CONFIG_PATH = os.path.join(CONFIG_DIR, 'config.json')

PRESETS = {
    "strict": {
        "title": "🎯 Bureau",
        "subtitle": "0 - 1m (Instantané)",
        "lq": 95,
        "rssi": -2,
        "delay": 1.0,
        "desc": "Verrouille dès les premiers pas hors du bureau."
    },
    "comfort": {
        "title": "🛋️ Pièce",
        "subtitle": "2 - 3m (Confort)",
        "lq": 80,
        "rssi": -6,
        "delay": 2.5,
        "desc": "Permet de bouger autour du bureau sans couper la session."
    },
    "exit": {
        "title": "🚪 Sortie",
        "subtitle": "+4m (Large)",
        "lq": 60,
        "rssi": -12,
        "delay": 4.0,
        "desc": "Ne verrouille qu'en quittant la pièce ou derrière un mur."
    }
}

DEFAULT_CONFIG = {
    "enabled": True,
    "preset": "strict",
    "device_mac": "3C:B0:ED:DC:A2:39",
    "device_name": "Nothing Phone (3)",
    "lq_threshold": 95,
    "rssi_threshold": -2,
    "delay_seconds": 1.0,
    "check_interval": 1.0,
    "unlock_grace_period": 60
}

STYLE_CSS = """
/* Minimalist Card Styling */
.card-box {
    background-color: alpha(@theme_fg_color, 0.04);
    border: 1px solid alpha(@theme_fg_color, 0.08);
    border-radius: 12px;
    padding: 16px;
}

.card-box-highlight {
    background-color: alpha(@theme_selected_bg_color, 0.08);
    border: 1px solid alpha(@theme_selected_bg_color, 0.25);
    border-radius: 12px;
    padding: 16px;
}

.pill-badge {
    background-color: alpha(@theme_selected_bg_color, 0.15);
    color: @theme_selected_bg_color;
    font-weight: bold;
    font-size: 0.85em;
    padding: 4px 10px;
    border-radius: 20px;
}

.signal-progress trough {
    min-height: 8px;
    border-radius: 6px;
    background-color: alpha(@theme_fg_color, 0.1);
    border: none;
}

.signal-progress progress {
    min-height: 8px;
    border-radius: 6px;
    background-color: #2ecc71;
    border: none;
}

.preset-btn {
    border-radius: 10px;
    padding: 10px 6px;
    font-weight: 500;
}

.preset-btn:checked {
    background-color: @theme_selected_bg_color;
    color: #FFFFFF;
}

.action-btn {
    border-radius: 10px;
    padding: 8px 16px;
}
"""

class DynamicLockApp(Gtk.Window):
    def __init__(self):
        super().__init__(title="Verrouillage Dynamique")
        self.set_default_size(440, 580)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_border_width(18)

        self.updating_ui_from_preset = False

        self.init_css()
        self.init_theme_sync()

        # Load config
        self.config = self.load_config()
        self.devices_list = []

        self.setup_ui()
        self.load_devices()
        self.apply_config_to_ui()

        # Live signal loop (every 500ms)
        GLib.timeout_add(500, self.update_live_signal)

    def init_css(self):
        css_provider = Gtk.CssProvider()
        css_provider.load_from_data(STYLE_CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            css_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def init_theme_sync(self):
        try:
            self.desktop_settings = Gio.Settings.new('org.gnome.desktop.interface')
            self.desktop_settings.connect('changed::color-scheme', self.on_system_theme_changed)
            self.desktop_settings.connect('changed::gtk-theme', self.on_system_theme_changed)
            self.sync_gtk_theme()
        except Exception:
            pass

    def on_system_theme_changed(self, settings, key):
        self.sync_gtk_theme()

    def sync_gtk_theme(self):
        try:
            scheme = self.desktop_settings.get_string('color-scheme')
            gtk_theme = self.desktop_settings.get_string('gtk-theme')
            is_dark = (scheme == 'prefer-dark' or 'dark' in gtk_theme.lower())
            gtk_settings = Gtk.Settings.get_default()
            if gtk_settings:
                gtk_settings.set_property('gtk-application-prefer-dark-theme', is_dark)
        except Exception:
            pass

    def load_config(self):
        try:
            if os.path.exists(CONFIG_PATH):
                with open(CONFIG_PATH, 'r') as f:
                    return {**DEFAULT_CONFIG, **json.load(f)}
        except Exception:
            pass
        return DEFAULT_CONFIG.copy()

    def save_config(self):
        os.makedirs(CONFIG_DIR, exist_ok=True)
        try:
            with open(CONFIG_PATH, 'w') as f:
                json.dump(self.config, f, indent=2)
        except Exception as e:
            print("Error saving config:", e)

    def setup_ui(self):
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        self.add(main_box)

        # HeaderBar
        header = Gtk.HeaderBar()
        header.set_title("Verrouillage Dynamique")
        header.set_show_close_button(True)
        self.set_titlebar(header)

        # Main Switch in HeaderBar
        self.switch_enabled = Gtk.Switch()
        self.switch_enabled.set_valign(Gtk.Align.CENTER)
        self.switch_enabled.connect("state-set", self.on_switch_toggled)
        header.pack_end(self.switch_enabled)

        # --- Card 1 : Hero Status & Telemetry ---
        card_hero = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        card_hero.get_style_context().add_class("card-box")

        # Top row: Device Selector & Battery Pill
        row_dev = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.combo_devices = Gtk.ComboBoxText()
        self.combo_devices.set_hexpand(True)
        self.combo_devices.connect("changed", self.on_device_changed)
        row_dev.pack_start(self.combo_devices, True, True, 0)

        self.lbl_battery = Gtk.Label(label="🔋 69%")
        self.lbl_battery.get_style_context().add_class("pill-badge")
        row_dev.pack_start(self.lbl_battery, False, False, 0)
        card_hero.pack_start(row_dev, False, False, 0)

        # Progress bar (Thin & Sleek)
        self.progress_signal = Gtk.ProgressBar()
        self.progress_signal.get_style_context().add_class("signal-progress")
        self.progress_signal.set_fraction(1.0)
        card_hero.pack_start(self.progress_signal, False, False, 0)

        # Status text row
        row_status = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.lbl_status = Gtk.Label(xalign=0)
        self.lbl_status.set_markup("<span color='#2ecc71'>● <b>À proximité immédiate</b></span>")
        row_status.pack_start(self.lbl_status, True, True, 0)

        self.lbl_signal_val = Gtk.Label(label="100% • 0 dBm", xalign=1)
        self.lbl_signal_val.get_style_context().add_class("dim-label")
        row_status.pack_start(self.lbl_signal_val, False, False, 0)
        card_hero.pack_start(row_status, False, False, 0)

        main_box.pack_start(card_hero, False, False, 0)

        # --- Card 2 : Presets (Bandes de Distance) ---
        box_presets_wrapper = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        
        lbl_presets_title = Gtk.Label(xalign=0)
        lbl_presets_title.set_markup("<b>Zone de détection</b>")
        box_presets_wrapper.pack_start(lbl_presets_title, False, False, 0)

        grid_presets = Gtk.Grid()
        grid_presets.set_column_homogeneous(True)
        grid_presets.set_column_spacing(8)

        self.btn_strict = Gtk.RadioButton.new_with_label_from_widget(None, "🎯 Bureau\n<small>0 - 1m</small>")
        self.btn_strict.get_child().set_use_markup(True)
        self.btn_strict.set_mode(False)
        self.btn_strict.get_style_context().add_class("preset-btn")
        self.btn_strict.connect("toggled", lambda b: self.on_preset_btn_toggled("strict") if b.get_active() else None)
        grid_presets.attach(self.btn_strict, 0, 0, 1, 1)

        self.btn_comfort = Gtk.RadioButton.new_with_label_from_widget(self.btn_strict, "🛋️ Pièce\n<small>2 - 3m</small>")
        self.btn_comfort.get_child().set_use_markup(True)
        self.btn_comfort.set_mode(False)
        self.btn_comfort.get_style_context().add_class("preset-btn")
        self.btn_comfort.connect("toggled", lambda b: self.on_preset_btn_toggled("comfort") if b.get_active() else None)
        grid_presets.attach(self.btn_comfort, 1, 0, 1, 1)

        self.btn_exit = Gtk.RadioButton.new_with_label_from_widget(self.btn_strict, "🚪 Sortie\n<small>+4m</small>")
        self.btn_exit.get_child().set_use_markup(True)
        self.btn_exit.set_mode(False)
        self.btn_exit.get_style_context().add_class("preset-btn")
        self.btn_exit.connect("toggled", lambda b: self.on_preset_btn_toggled("exit") if b.get_active() else None)
        grid_presets.attach(self.btn_exit, 2, 0, 1, 1)

        box_presets_wrapper.pack_start(grid_presets, False, False, 0)

        self.lbl_preset_desc = Gtk.Label(xalign=0)
        self.lbl_preset_desc.set_markup("<small class='dim-label'>Verrouille dès les premiers pas hors du bureau.</small>")
        box_presets_wrapper.pack_start(self.lbl_preset_desc, False, False, 0)

        main_box.pack_start(box_presets_wrapper, False, False, 0)

        # --- Expander : Réglages Précis (Curseurs repliables) ---
        expander = Gtk.Expander(label="Ajustements manuels précis")
        box_sliders = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box_sliders.set_margin_top(8)
        box_sliders.set_margin_bottom(8)
        box_sliders.get_style_context().add_class("card-box")

        # Slider Seuil
        row_lq = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        lbl_lq = Gtk.Label(label="Sensibilité requise :", xalign=0)
        self.lbl_lq_val = Gtk.Label(label="95%", xalign=1)
        self.lbl_lq_val.get_style_context().add_class("pill-badge")
        row_lq.pack_start(lbl_lq, True, True, 0)
        row_lq.pack_start(self.lbl_lq_val, False, False, 0)
        box_sliders.pack_start(row_lq, False, False, 0)

        self.scale_lq = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 50, 98, 1)
        self.scale_lq.set_draw_value(False)
        self.scale_lq.connect("value-changed", self.on_lq_scale_changed)
        box_sliders.pack_start(self.scale_lq, False, False, 0)

        # Slider Délai
        row_delay = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        lbl_delay = Gtk.Label(label="Délai avant verrouillage :", xalign=0)
        self.lbl_delay_val = Gtk.Label(label="1.0s", xalign=1)
        self.lbl_delay_val.get_style_context().add_class("pill-badge")
        row_delay.pack_start(lbl_delay, True, True, 0)
        row_delay.pack_start(self.lbl_delay_val, False, False, 0)
        box_sliders.pack_start(row_delay, False, False, 0)

        self.scale_delay = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0.5, 8.0, 0.5)
        self.scale_delay.set_draw_value(False)
        self.scale_delay.connect("value-changed", self.on_delay_scale_changed)
        box_sliders.pack_start(self.scale_delay, False, False, 0)

        expander.add(box_sliders)
        main_box.pack_start(expander, False, False, 0)

        # Spacer
        spacer = Gtk.Box()
        main_box.pack_start(spacer, True, True, 0)

        # --- Footer Actions ---
        btn_test = Gtk.Button.new_with_label("🔒 Tester le verrouillage immédiat")
        btn_test.get_style_context().add_class("action-btn")
        btn_test.connect("clicked", lambda b: subprocess.run(['loginctl', 'lock-session']))
        main_box.pack_start(btn_test, False, False, 0)

    def load_devices(self):
        self.combo_devices.remove_all()
        self.devices_list = []
        try:
            out = subprocess.check_output(['bluetoothctl', 'devices'], stderr=subprocess.DEVNULL).decode().strip()
            for line in out.splitlines():
                parts = line.split()
                if len(parts) >= 3 and parts[0] == 'Device':
                    mac = parts[1]
                    name = " ".join(parts[2:])
                    self.devices_list.append((mac, name))
                    self.combo_devices.append(mac, f"{name}")
        except Exception:
            pass

        mac = self.config.get("device_mac")
        if mac:
            self.combo_devices.set_active_id(mac)
        elif self.devices_list:
            self.combo_devices.set_active(0)

    def apply_config_to_ui(self):
        self.updating_ui_from_preset = True
        self.switch_enabled.set_active(self.config.get("enabled", True))
        
        preset_key = self.config.get("preset", "strict")
        if preset_key == "strict":
            self.btn_strict.set_active(True)
        elif preset_key == "comfort":
            self.btn_comfort.set_active(True)
        elif preset_key == "exit":
            self.btn_exit.set_active(True)

        if preset_key in PRESETS:
            self.lbl_preset_desc.set_markup(f"<small class='dim-label'>{PRESETS[preset_key]['desc']}</small>")

        lq = self.config.get("lq_threshold", 95)
        self.scale_lq.set_value(lq)
        self.lbl_lq_val.set_text(f"{int(lq)}%")

        delay = self.config.get("delay_seconds", 1.0)
        self.scale_delay.set_value(delay)
        self.lbl_delay_val.set_text(f"{delay:.1f}s")
        self.updating_ui_from_preset = False

    def on_switch_toggled(self, switch, state):
        self.config["enabled"] = state
        self.save_config()

    def on_device_changed(self, combo):
        active_id = combo.get_active_id()
        if active_id:
            self.config["device_mac"] = active_id
            for mac, name in self.devices_list:
                if mac == active_id:
                    self.config["device_name"] = name
                    break
            self.save_config()

    def on_preset_btn_toggled(self, preset_key):
        if preset_key not in PRESETS:
            return

        pinfo = PRESETS[preset_key]
        self.lbl_preset_desc.set_markup(f"<small class='dim-label'>{pinfo['desc']}</small>")
        self.config["preset"] = preset_key
        
        self.updating_ui_from_preset = True
        self.config["lq_threshold"] = pinfo["lq"]
        self.config["rssi_threshold"] = pinfo["rssi"]
        self.config["delay_seconds"] = pinfo["delay"]

        self.scale_lq.set_value(pinfo["lq"])
        self.lbl_lq_val.set_text(f"{pinfo['lq']}%")

        self.scale_delay.set_value(pinfo["delay"])
        self.lbl_delay_val.set_text(f"{pinfo['delay']:.1f}s")
        self.updating_ui_from_preset = False

        self.save_config()

    def on_lq_scale_changed(self, scale):
        val = int(scale.get_value())
        self.lbl_lq_val.set_text(f"{val}%")
        self.config["lq_threshold"] = val
        if not self.updating_ui_from_preset:
            self.config["preset"] = "custom"
        self.save_config()

    def on_delay_scale_changed(self, scale):
        val = round(scale.get_value(), 1)
        self.lbl_delay_val.set_text(f"{val:.1f}s")
        self.config["delay_seconds"] = val
        if not self.updating_ui_from_preset:
            self.config["preset"] = "custom"
        self.save_config()

    def update_live_signal(self):
        mac = self.config.get("device_mac")
        if not mac:
            self.progress_signal.set_fraction(0.0)
            self.lbl_status.set_markup("<span color='#e74c3c'>● Aucun appareil</span>")
            self.lbl_signal_val.set_text("N/A")
            return True

        lq = None
        rssi = None
        connected = False

        try:
            out = subprocess.check_output(['bluetoothctl', 'info', mac], stderr=subprocess.DEVNULL).decode()
            connected = ('Connected: yes' in out)
        except Exception:
            connected = False

        if connected:
            try:
                out = subprocess.check_output(['hcitool', 'lq', mac], stderr=subprocess.DEVNULL).decode().strip()
                if 'Link quality:' in out:
                    lq = int(out.split(':')[1].strip())
            except Exception:
                lq = None

            try:
                out = subprocess.check_output(['hcitool', 'rssi', mac], stderr=subprocess.DEVNULL).decode().strip()
                if 'RSSI return value:' in out:
                    rssi = int(out.split(':')[1].strip())
            except Exception:
                rssi = None

        # Battery update
        try:
            out = subprocess.check_output(['adb', 'shell', 'dumpsys', 'battery'], stderr=subprocess.DEVNULL).decode()
            for line in out.splitlines():
                if 'level:' in line:
                    bval = line.split(':')[1].strip()
                    self.lbl_battery.set_text(f"🔋 {bval}%")
                    break
        except Exception:
            pass

        thresh = self.config.get("lq_threshold", 95)

        if not connected:
            self.progress_signal.set_fraction(0.0)
            self.lbl_status.set_markup("<span color='#e74c3c'>● <b>Signal perdu</b></span>")
            self.lbl_signal_val.set_text("Déconnecté")
        elif lq is not None:
            frac = max(0.0, min(1.0, lq / 100.0))
            self.progress_signal.set_fraction(frac)
            rssi_str = f"{rssi} dBm" if rssi is not None else "0 dBm"
            self.lbl_signal_val.set_text(f"{lq}% • {rssi_str}")
            
            if lq >= thresh:
                self.lbl_status.set_markup("<span color='#2ecc71'>● <b>À proximité immédiate</b></span>")
            else:
                self.lbl_status.set_markup("<span color='#f39c12'>● <b>Éloignement détecté</b></span>")
        else:
            self.progress_signal.set_fraction(0.5)
            self.lbl_status.set_markup("<span color='#3498db'>● Recherche du signal...</span>")
            self.lbl_signal_val.set_text("--")

        return True

def main():
    app = DynamicLockApp()
    app.connect("destroy", Gtk.main_quit)
    app.show_all()
    Gtk.main()

if __name__ == '__main__':
    main()
