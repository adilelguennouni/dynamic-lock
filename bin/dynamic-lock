#!/usr/bin/env python3
"""
Dynamic Lock Daemon for Linux / Pop!_OS.
Features an intelligent Standby/Armed State Machine:
- Never locks if device is offline at session start or Bluetooth is off.
- Automatically Arms once the monitored device connects in proximity.
- Triggers lock only when moving away while Armed.
- Automatically returns to Standby upon manual unlock.
"""

import time
import json
import os
import subprocess
import gi
gi.require_version('Gio', '2.0')
from gi.repository import Gio

CONFIG_PATH = os.path.expanduser('~/.config/dynamic-lock/config.json')
STATE_PATH = os.path.expanduser('~/.config/dynamic-lock/state.json')

DEFAULT_CONFIG = {
    "enabled": True,
    "device_mac": "",
    "device_name": "",
    "lq_threshold": 90,
    "rssi_threshold": -2,
    "delay_seconds": 2.0,
    "check_interval": 1.0
}

def load_config():
    try:
        if os.path.exists(CONFIG_PATH):
            with open(CONFIG_PATH, 'r') as f:
                return {**DEFAULT_CONFIG, **json.load(f)}
    except Exception:
        pass
    return DEFAULT_CONFIG

def save_state(state_data):
    try:
        os.makedirs(os.path.dirname(STATE_PATH), exist_ok=True)
        tmp = STATE_PATH + '.tmp'
        with open(tmp, 'w') as f:
            json.dump({**state_data, "updated_at": time.time()}, f)
        os.replace(tmp, STATE_PATH)
    except Exception:
        pass

def is_screen_locked():
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        res = bus.call_sync(
            'org.gnome.ScreenSaver',
            '/org/gnome/ScreenSaver',
            'org.gnome.ScreenSaver',
            'GetActive',
            None,
            None,
            Gio.DBusCallFlags.NONE,
            -1,
            None
        )
        return bool(res.unpack()[0])
    except Exception:
        return False

def lock_screen():
    try:
        print("[DynamicLock] Locking session...")
        subprocess.run(['loginctl', 'lock-session'], check=False)
    except Exception as e:
        print(f"[DynamicLock] Error locking: {e}")

def notify_user(title, message):
    try:
        subprocess.run(['notify-send', '-a', 'Dynamic Lock', '-i', 'system-lock-screen', title, message], check=False)
    except Exception:
        pass

def get_metrics(mac):
    lq = None
    rssi = None
    connected = False

    try:
        out = subprocess.check_output(['bluetoothctl', 'info', mac], stderr=subprocess.DEVNULL).decode()
        connected = ('Connected: yes' in out)
    except Exception:
        connected = False

    if not connected:
        return None, None, False

    try:
        out = subprocess.check_output(['hcitool', 'lq', mac], stderr=subprocess.DEVNULL).decode().strip()
        if 'Link quality:' in out:
            lq = int(out.split(':')[1].strip())
    except Exception:
        lq = None

    try:
        out = subprocess.check_output(['hcitool', 'rssi', mac], stderr=subprocess.DEVNULL).decode().strip()
        if 'RSSI return value:' in out:
            rssi = int(out.split(':')[1].strip())
    except Exception:
        rssi = None

    return lq, rssi, connected

def main():
    print("[DynamicLock] Daemon started with Smart Standby/Armed State Machine.")
    is_armed = False
    away_time_acc = 0.0
    was_locked = False

    while True:
        cfg = load_config()

        if not cfg.get("enabled", True):
            is_armed = False
            away_time_acc = 0.0
            save_state({"state": "disabled", "armed": False, "connected": False, "lq": None, "rssi": None})
            time.sleep(2)
            continue

        screen_locked = is_screen_locked()

        # When screen is locked
        if screen_locked:
            was_locked = True
            is_armed = False
            away_time_acc = 0.0
            save_state({"state": "locked", "armed": False, "connected": False, "lq": None, "rssi": None})
            time.sleep(2.5)
            continue

        # Detect transition from locked -> unlocked (user typed password/fingerprint)
        if was_locked and not screen_locked:
            was_locked = False
            is_armed = False  # Reset to Standby mode!
            away_time_acc = 0.0
            print("[DynamicLock] Session unlocked. Dynamic Lock is in STANDBY mode.")

        mac = cfg.get("device_mac")
        if not mac:
            is_armed = False
            away_time_acc = 0.0
            save_state({"state": "no_device", "armed": False, "connected": False, "lq": None, "rssi": None})
            time.sleep(2)
            continue

        check_interval = max(0.5, float(cfg.get("check_interval", 1.0)))
        delay_threshold = max(0.5, float(cfg.get("delay_seconds", 2.0)))
        lq_threshold = int(cfg.get("lq_threshold", 90))
        rssi_threshold = int(cfg.get("rssi_threshold", -2))

        lq, rssi, connected = get_metrics(mac)

        # Proximity criteria
        is_in_range = connected and (lq is not None and lq >= lq_threshold) and (rssi is None or rssi > rssi_threshold)

        if not is_armed:
            # === STANDBY MODE ===
            # We only transition to ARMED if the device is connected AND verified in close proximity
            if is_in_range:
                is_armed = True
                away_time_acc = 0.0
                print(f"[DynamicLock] Device '{cfg.get('device_name')}' connected in proximity. System is now ARMED.")
                save_state({
                    "state": "armed",
                    "armed": True,
                    "device_name": cfg.get("device_name", ""),
                    "connected": True,
                    "lq": lq,
                    "rssi": rssi,
                    "away_seconds": 0.0
                })
            else:
                # Device is not connected or out of range: STAY in standby, NEVER lock!
                away_time_acc = 0.0
                save_state({
                    "state": "standby",
                    "armed": False,
                    "device_name": cfg.get("device_name", ""),
                    "connected": connected,
                    "lq": lq,
                    "rssi": rssi,
                    "away_seconds": 0.0
                })
        else:
            # === ARMED MODE ===
            # System is actively protecting the session
            if not is_in_range:
                away_time_acc += check_interval
                print(f"[DynamicLock] Away detected ({away_time_acc:.1f}s / {delay_threshold:.1f}s)")
                save_state({
                    "state": "away",
                    "armed": True,
                    "device_name": cfg.get("device_name", ""),
                    "connected": connected,
                    "lq": lq,
                    "rssi": rssi,
                    "away_seconds": away_time_acc
                })
                if away_time_acc >= delay_threshold:
                    if cfg.get("notify_on_lock", True):
                        notify_user("Dynamic Lock", "Appareil hors de portée. Verrouillage de la session...")
                    lock_screen()
                    is_armed = False  # Disarm immediately upon locking
                    was_locked = True
                    away_time_acc = 0.0
                    save_state({
                        "state": "locked",
                        "armed": False,
                        "device_name": cfg.get("device_name", ""),
                        "connected": False,
                        "lq": None,
                        "rssi": None,
                        "away_seconds": 0.0
                    })
                    time.sleep(3)
                    continue
            else:
                # Device is in range, reset away accumulator
                away_time_acc = 0.0
                save_state({
                    "state": "armed",
                    "armed": True,
                    "device_name": cfg.get("device_name", ""),
                    "connected": True,
                    "lq": lq,
                    "rssi": rssi,
                    "away_seconds": 0.0
                })

        time.sleep(check_interval)

if __name__ == '__main__':
    main()
